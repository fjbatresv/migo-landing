---
import '../styles/global.css';
import { Font } from 'astro:assets';
const { copy } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const canonical = new URL(copy.lang === 'es' ? 'es/' : '', baseUrl).href;
const en = new URL('', baseUrl).href;
const es = new URL('es/', baseUrl).href;
const og = new URL(copy.lang === 'es' ? 'assets/og-migo-es.png' : 'assets/og-migo-en.png', baseUrl).href;
const person = 'https://fjbatresv.com/#person';
const graph = { '@context':'https://schema.org', '@graph':[
  { '@type':'Person','@id':person,'name':'Javier Batres','jobTitle':'Architect / Tech Lead / Staff Engineer','url':'https://fjbatresv.com/','sameAs':['https://github.com/fjbatresv','https://www.linkedin.com/in/javierbatres/'] },
  { '@type':'WebSite','@id':`${en}#website`,'url':en,'name':'Migo Payments case study','inLanguage':[ 'en','es' ] },
  { '@type':'WebPage','@id':`${canonical}#webpage`,'url':canonical,'name':copy.title,'inLanguage':copy.lang,'isPartOf':{'@id':`${en}#website`},'about':{'@id':person} },
  { '@type':'TechArticle','@id':`${canonical}#article`,'headline':copy.title,'dateCreated':'2021-11','dateModified':'2022-06-13','datePublished':'2026-11-24','author':{'@id':person},'mainEntityOfPage':canonical,'inLanguage':copy.lang },
  { '@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':copy.lang==='es'?es:en},{'@type':'ListItem','position':2,'name':'Migo Payments'}] }
]};
---
<!doctype html><html lang={copy.lang} data-theme="light"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{copy.title}</title><meta name="description" content={copy.description} /><meta name="theme-color" content="#1790FE" />
  <link rel="canonical" href={canonical} /><link rel="alternate" hreflang="en" href={en} /><link rel="alternate" hreflang="es" href={es} /><link rel="alternate" hreflang="x-default" href={en} />
  <link rel="icon" href={`${base}assets/favicon.svg`} type="image/svg+xml" />
  <meta property="og:type" content="article" /><meta property="og:title" content={copy.title} /><meta property="og:description" content={copy.description} /><meta property="og:url" content={canonical} /><meta property="og:site_name" content="Migo Payments case study" /><meta property="og:locale" content={copy.lang==='es'?'es_GT':'en_US'} /><meta property="og:image" content={og} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Migo Payments architecture and transaction journey case study" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={copy.title} /><meta name="twitter:description" content={copy.description} /><meta name="twitter:image" content={og} />
  <Font cssVariable="--font-display" preload /><Font cssVariable="--font-body" preload={false} /><Font cssVariable="--font-mono" preload={false} />
  <script type="application/ld+json" set:html={JSON.stringify(graph)}></script>
</head><body><a class="skip-link" href="#main">{copy.skip}</a><slot /></body></html>
