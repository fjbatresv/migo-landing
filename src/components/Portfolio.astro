---
import ArchitectureDiagram from './ArchitectureDiagram.astro';
const { copy } = Astro.props;
const mail = (subject: string) => `mailto:fjbatresv@gmail.com?subject=${encodeURIComponent(`${subject} — via Migo case study`)}`;
const base = import.meta.env.BASE_URL;
---
<header class="site-header"><a class="brand" href={copy.lang==='es'?`${base}es/`:base} aria-label="Migo case study home"><img src={`${base}assets/logo-migo.svg`} width="125" height="32" alt="Migo" /></a><nav aria-label={copy.navLabel}>{copy.nav.map(([id,label]:[string,string])=><a href={`#${id}`}>{label}</a>)}</nav><div class="header-tools"><a class="lang" href={copy.lang==='en'?`${base}es/`:base}>{copy.lang==='en'?'ES':'EN'}</a><button class="theme-toggle" type="button" aria-label={copy.themeLabel}><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z"/></svg></button><a class="home-chip" href="https://fjbatresv.com">fjbatresv.com ↗</a></div></header>
<main id="main">
  <section class="hero"><div class="hero-copy"><p class="eyebrow">{copy.heroKicker}</p><h1>{copy.hero}</h1><p class="hero-intro">{copy.intro}</p><div class="hero-actions"><a class="button primary" href={mail(copy.hire)}>{copy.hire}<span aria-hidden="true"> ↗</span></a><a class="button secondary" href="#architecture">{copy.see}<span aria-hidden="true"> ↓</span></a></div></div><aside class="snapshot"><span class="snapshot-label">ARCHIVE / PAYMENT SYSTEMS</span><div class="stamp">{copy.snapshot}</div><svg viewBox="0 0 240 78" role="img" aria-label="Payment flow: chat to checkout to settlement"><path d="M12 38H228" stroke="url(#route)" stroke-width="3"/><defs><linearGradient id="route"><stop stop-color="#1155CC"/><stop offset=".53" stop-color="#7600FF"/><stop offset="1" stop-color="#00D0D2"/></linearGradient></defs>{[12,82,158,228].map((x,i)=><g><circle cx={x} cy="38" r="10" fill={['#1155CC','#0D73FE','#00BEC1','#1155CC'][i]}/><text x={x} y="70" text-anchor="middle">{['CHAT','PAY','API','OK'][i]}</text></g>)}</svg></aside><div class="metrics">{copy.metrics.map(([value,label]:[string,string])=><div><strong>{value}</strong><span>{label}</span></div>)}</div></section>
  <section class="section problem"><div class="section-head"><p class="eyebrow">{copy.eyebrows[0]}</p><h2>{copy.problemTitle}</h2></div><p class="lead">{copy.problem}</p><div class="rail-tags"><span>SINPE · CR</span><span>PSE · CO</span><span>Cards · 3-D Secure</span><span>Yalo · WhatsApp commerce</span></div></section>
  <section class="section journey" id="journey"><div class="section-head"><p class="eyebrow">{copy.eyebrows[1]}</p><h2>{copy.journeyTitle}</h2><p>{copy.journeyIntro}</p></div><ol class="stepper">{copy.steps.map(([title,detail]:[string,string],i:number)=><li><button type="button" data-step={i} aria-pressed={i===0?'true':'false'}><span class="step-number">0{i+1}</span><span><b>{title}</b><small>{detail}</small></span></button></li>)}</ol><p class="sr-only" aria-live="polite" data-step-status></p></section>
  <ArchitectureDiagram copy={copy} />
  <section class="section decisions" id="decisions"><div class="section-head"><p class="eyebrow">{copy.eyebrows[3]}</p><h2>{copy.decisionsTitle}</h2></div><div class="decision-list">{copy.decisions.map(([id,title,decision,tradeoff]:string[])=><article><span class="decision-id">{id}</span><div><h3>{title}</h3><p>{decision}</p></div><p class="tradeoff">{tradeoff}</p></article>)}</div></section>
  <section class="section quality" id="quality"><div class="quality-inner"><div><p class="eyebrow">{copy.eyebrows[4]}</p><h2>{copy.qualityTitle}</h2><p>{copy.qualityIntro}</p></div><ul>{copy.qualityFacts.map((fact:string)=><li>{fact}</li>)}</ul><p class="quality-note">{copy.qualityNote}</p></div></section>
  <section class="section role" id="role"><div class="section-head"><p class="eyebrow">{copy.eyebrows[5]}</p><h2>{copy.roleTitle}</h2></div><p class="lead">{copy.role}</p><div class="role-metrics">{copy.roleMetrics.map(([value,label]:[string,string])=><p><strong>{value}</strong><span>{label}</span></p>)}</div></section>
  <section class="section contact" id="contact"><div><p class="eyebrow">{copy.eyebrows[6]}</p><h2>{copy.contactTitle}</h2><p>{copy.contactIntro}</p></div><div class="contact-actions"><a class="button primary" href={mail(copy.contact1)}>{copy.contact1} ↗</a><a class="button secondary" href={mail(copy.contact2)}>{copy.contact2} ↗</a><a class="text-link" href="https://www.linkedin.com/in/javierbatres/">{copy.linkedin} ↗</a></div></section>
</main>
<footer><div><img src={`${base}assets/logo-migo.svg`} width="94" height="24" alt="Migo" loading="lazy"/><p>{copy.footerNote}</p></div><div><b>{copy.other}</b><p><a href="https://sdg19.fjbatresv.com">sdg19</a> · <a href="https://guso.fjbatresv.com">guso</a> · <a href="https://sinergia.fjbatresv.com">sinergia</a> · <a href="https://pettzi.fjbatresv.com">pettzi</a></p></div><div><a href="https://github.com/fjbatresv/migo-landing">{copy.repo}</a><p><a href="https://github.com/fjbatresv/migo-landing/blob/main/LICENCE.md">{copy.license}</a></p></div></footer>
<script>
  document.documentElement.classList.add('js');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
  const targets = ['checkout','checkout','authorizer','processor','processor','webhook','webhook','voucher'];
  function selectStep(index: number) { buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index))); document.querySelectorAll('[data-node]').forEach(node => node.classList.toggle('is-active', node.getAttribute('data-node') === targets[index])); const status=document.querySelector('[data-step-status]'); if(status) status.textContent=buttons[index]?.innerText ?? ''; }
  buttons.forEach((button, index) => button.addEventListener('click', () => selectStep(index)));
  selectStep(0);
  document.querySelectorAll<HTMLButtonElement>('[data-view-button]').forEach(button=>button.addEventListener('click',()=>{const wrap=document.querySelector('.diagram-wrap'); if(wrap) wrap.setAttribute('data-view',button.dataset.viewButton ?? 'diagram'); document.querySelectorAll('[data-view-button]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
  const theme=document.querySelector<HTMLButtonElement>('.theme-toggle'); theme?.addEventListener('click',()=>{const dark=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=dark?'dark':'light';localStorage.setItem('migo-theme',dark?'dark':'light');});
  try { const saved=localStorage.getItem('migo-theme'); if(saved) document.documentElement.dataset.theme=saved; } catch {}
  const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('revealed');observer.unobserve(entry.target);}}),{threshold:.12}); document.querySelectorAll('.section').forEach(section=>observer.observe(section));
  document.querySelector<HTMLAnchorElement>('.lang')?.addEventListener('click',()=>{const link=document.querySelector<HTMLAnchorElement>('.lang');if(link&&location.hash)link.href+=location.hash;});
</script>
